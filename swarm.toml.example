# swarm.toml -- configuration for the opencode-swarm ops tool (scripts/swarm.py).
#
# swarm.py looks for this file at: the path given by --config, else
# $SWARM_CONFIG, else `swarm.toml` or `.swarm/swarm.toml` in the current
# directory or any parent directory (so an ops dir kept inside the repo as
# .swarm/ needs no flag). Everything the tool writes (data/, out/, prompts/,
# specs/) lives next to this file. Copy this file to your ops directory as
# `swarm.toml` and edit it, or run:
#   swarm.py init --name "My Project" --repo /path/to/repo
# which does that for you (and creates the data/out/prompts/specs dirs).

[project]
# Human-readable name. Shown in the dashboard header and used to build the
# default export filename (out/<slugified-name>-replay.html).
name = "My Project"

# Absolute path to the main repo checkout -- the branch you merge finished
# work into. swarm.py never runs an OpenCode worker or creates a worktree
# here; `run` and `wt` both refuse a --dir that resolves to this path.
repo = "/path/to/repo"

# Where task and review worktrees are created. `swarm.py run --dir` and
# `swarm.py wt` both refuse to touch anything outside this directory --
# OpenCode runs with full filesystem permissions inside --dir, so this is
# the one boundary that matters.
worktrees = "/path/to/repo-wt"

# Paths OpenCode must never be pointed at, even if they happen to sit inside
# `worktrees` (e.g. a scratch/archive dir you keep alongside it). One per
# line; a --dir that equals or sits inside any of these is refused.
forbidden = [
    "/path/to/archive",
]

# Where `swarm.py sync` copies events.jsonl, ledger.jsonl, prompts/, specs/
# and shots/*.png, relative to `repo`. Run this after merging a phase so the
# game/app repo keeps its own copy of the ops history.
records_dir = "tools/swarm-records"

# Informational only -- surfaced for prompts/README use. swarm.py does not
# invoke either of these itself.
test_cmd = "pytest -q"
lint_cmd = "ruff check ."

# Set true when the repo holds credentials, personal data, or private or client code. `swarm.py run` then refuses
# every model that does not set trains_on_prompts = false, reviewers included. This restricts WHICH providers may
# see the data (no training on prompts); it does not keep the data on this machine. For data that must never leave
# the machine, use no remote model at all. Off by default.
# Not covered: driver = "claude" subagents, which `run` never launches, and the manager, advisor and scribe agents,
# which read the code outside `run` (the scribe sees output snippets on the board). Keep them off sensitive repos unless the planner accepts that those models see the code.
sensitive = false

# Set true to make `swarm.py run` refuse any phase whose spec has no Gates section or whose spec is not
# committed on main in <records_dir>/specs/ (the pre-registration rule, runbook step 0). Off by default.
require_gates = false


# Optional label shown on the dashboard as the orchestrating agent (swarm.py reads it for board metadata).
# orchestrator = ""

[opencode]
# Executable used for every `opencode run` / `opencode export` call. Point
# this at a stub for tests (a small script that prints `--format json` lines
# and handles `export <sid>`; see the skill's references for the shape).
bin = "opencode"

# Optional: pass `--agent <name>` on every `opencode run` call. Leave unset
# to use OpenCode's default agent.
# agent = "build"

# Each worker model swarm.py can drive. `key` is what you pass on the
# command line (`swarm.py run p1 unit-pool luna --dir ...`); `id` is the
# model id passed to the driver's CLI (an OpenCode `provider/model` string,
# or a Grok model id -- see [grok] below); `name` is the display name used
# in the dashboard and reports. 1 to 6 entries. These three were the best value in
# the 2026-10 bake-offs (see references/lessons.md) -- swap them for your own roster.
#
# `driver` (optional, default "opencode") picks which CLI `swarm.py run`
# launches for this model: "opencode" or "grok" (see [grok] below and
# references/grok-cli.md). `driver = "claude"` is also recognized but never
# launched by `run` -- it documents a worker driven as a Claude Agent-tool
# subagent instead, and `run` refuses it with a clear error.
#
# `role` (optional) is descriptive text shown under the model's name on the
# dashboard lane; falls back to `id` when unset.
[[models]]
key = "sol"
id = "openrouter/openai/gpt-6.1-sol"
name = "GPT-6.1 Sol"
# trains_on_prompts = false   # set only if the provider's terms say prompts are not used for training.
# With [project] sensitive = true, a model without this flag is refused: at least one model must set it.
# driver = "opencode"
# role = ""

# FREE, but the provider may train on prompts and code: NEVER use this model on sensitive data
# (credentials, personal data, private or client code). Fine for public or throwaway work.
# `trains_on_prompts` is the flag that `[project] sensitive = true` checks: set it to false only when the
# provider's terms say prompts are not used for training. An unset flag counts as "may train".
[[models]]
key = "musefree"
id = "opencode/muse-spark-1.3-contributor-free"
name = "Muse Spark 1.3 Contributor (free)"
trains_on_prompts = true
# driver = "opencode"
# role = "free tier: no sensitive data"

[[models]]
key = "flash"
id = "openrouter/deepseek/deepseek-v4.1-flash"
name = "DeepSeek V4.1 Flash"
# trains_on_prompts = false   # set only if the provider's terms say prompts are not used for training

# driver = "opencode"
# role = ""

# Claude Haiku 5.5 through OpenRouter, the same route as the other roster models. Cheap, fast; good for scribing,
# triage and routine work. Not free: trains_on_prompts stays unset (= may train) until its terms are checked, so a
# sensitive project refuses it.
[[models]]
key = "haiku"
id = "openrouter/anthropic/claude-haiku-5.5"
name = "Claude Haiku 5.5"
# driver = "opencode"
# role = "cheap: triage, routine work"


# Phases shown on the dashboard's phase rail and used to bucket spend
# (`swarm.py phase <id> active|done` moves the pointer). This is a generic
# 6-phase template -- rename/reword freely, add or remove phases, as long as
# every `run`/`task`/`phase` call uses one of the ids listed here.
[[phases]]
id = "p0"
title = "Foundations"
goal = "Repo, interfaces, acceptance tests, worker rules."
exit = "Test suite runs; stubs import; contracts documented."

[[phases]]
id = "p1"
title = "Bake-off"
goal = "Every model builds the same slice from the same spec, independently."
exit = "Winner merged; per-model scorecard recorded."

[[phases]]
id = "p2"
title = "Walking skeleton"
goal = "The thinnest end-to-end path through the system, built in parallel."
exit = "The whole system runs once, start to finish, even if it does almost nothing."

[[phases]]
id = "p3"
title = "Core features"
goal = "The features that make this the thing it's actually supposed to be."
exit = "The core use case works end to end without hand-holding."

[[phases]]
id = "p4"
title = "Second layer"
goal = "Everything the core cut corners on: breadth, persistence, edge cases."
exit = "A realistic session exercises the second layer without falling over."

[[phases]]
id = "p5"
title = "Polish & demo"
goal = "Performance, rough edges, a final review pass."
exit = "A clean run-through is ready to demo, start to finish."

[watchdog]
# `run`'s two-stage watchdog, in seconds. `stall` applies while the worker
# has printed nothing at all yet; `stall_active` once it has started
# printing (a worker can go quiet for a while while writing a large file).
# `timeout` is the hard overall wall-clock limit regardless of activity.
stall = 120
stall_active = 600
timeout = 1800

[grok]
# Executable used for every Grok worker `swarm.py run` launches (a model
# with `driver = "grok"` above). Point this at a stub for tests -- a small
# script that parses argv, writes it somewhere inspectable, and prints a
# few `--output-format streaming-json` lines ending in an `end` event; see
# references/grok-cli.md for the exact argv shape and event fields read back.
bin = "grok"

# Turn cap passed as `--max-turns` on every Grok run.
max_turns = 40

# Optional: passed as `--reasoning-effort <value>` when set (e.g. "low",
# "medium", "high"). Leave unset to use the model's own default.
# reasoning_effort = "low"

# Sandbox profile passed as `--sandbox <profile>` on every Grok run. Unlike
# `--dir`/`--cwd` (which only sets the working directory, not a filesystem
# boundary), a sandbox profile is the actual confinement -- see
# references/grok-cli.md, including an Ubuntu bubblewrap/AppArmor gotcha.
# `swarm.py run` refuses to launch a Grok worker when this is empty unless
# `allow_unsandboxed = true` below.
sandbox = "swarm-worker"

# Explicitly opt in to running Grok workers with no sandbox profile at all.
# Off by default.
allow_unsandboxed = false

[dashboard]
# The live dashboard artifact's claude.ai URL, if you have one published.
# Only used as a hint printed by `swarm.py push` (to stderr); swarm.py never
# calls it itself.
url = ""

[claude]
# Where Claude Code session transcripts live, for `swarm.py claude`/`cost`.
session_dir = "~/.claude/projects/-path-to-repo"

# The orchestrator session id to tally (its subagents/agent-*.jsonl files
# are included automatically). Leave empty ("") to instead tally every
# *.jsonl under session_dir modified since the first event in this ops
# dir's log -- useful when you don't want to hardcode a session id.
session = ""

# $ per million tokens (Anthropic list prices): in, out, cache_read,
# cache_write_5m, cache_write_1h, plus a display name. Used for reporting
# only -- on a Claude subscription these tokens aren't billed per-token.
# swarm.py matches a transcript's model id to a table here by prefix, so
# e.g. "claude-sonnet-5-20260101" still matches "claude-sonnet-5" below.
[claude.prices."claude-opus-5-5"]
in = 4
out = 20
cache_read = 0.20
cache_write_5m = 5
cache_write_1h = 8
name = "Opus 5.5"

# Sonnet 5.5 (the advisor) is matched by this Sonnet 5 entry until its own list prices are added: check them.
[claude.prices."claude-sonnet-5"]
in = 2
out = 10
cache_read = 0.20
cache_write_5m = 2.50
cache_write_1h = 4
name = "Sonnet 5"

# Haiku 5.5 runs the scribe and the phase manager (see agents/claude). The numbers below are a
# PLACEHOLDER copied from the Haiku 4.5 tier: replace them with Haiku 5.5's list prices before trusting `cost`.
[claude.prices."claude-haiku-5-5"]
in = 1
out = 5
cache_read = 0.10
cache_write_5m = 1.25
cache_write_1h = 2
name = "Haiku 5.5"

[claude.prices."claude-haiku-4-5"]
in = 1
out = 5
cache_read = 0.10
cache_write_5m = 1.25
cache_write_1h = 2
name = "Haiku 4.5"
